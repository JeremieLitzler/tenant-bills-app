# Template for local development, committed. `create-env-proton-pass.sh` copies it to the
# gitignored `.env.proton-pass`, replacing the placeholders with the share and item IDs of the
# "local-tenant-bills-github-oauth" item in the "Common" Proton Pass vault. `pass-cli run
# --env-file .env.proton-pass -- netlify dev` then resolves the pass:// references at runtime,
# so no secret value is ever written to disk. See docs/environment-variables.md.
GITHUB_OAUTH_CLIENT_ID=pass://[share-id-of-target-vault]/[item-id-in-target-vault]/Client ID
GITHUB_OAUTH_CLIENT_SECRET=pass://[share-id-of-target-vault]/[item-id-in-target-vault]/Client Secret

# Not secrets: plain values. Local development reads and writes the `develop` branch of the
# data repo, never `main`.
DATA_REPO=JeremieLitzler/tenant-bills-data
DATA_BRANCH=develop
ALLOWED_LOGINS=JeremieLitzler
